{
  "name": "dsh-bundle-docker-upgrade",
  "version": "0.1.1",
  "private": true,
  "description": "Check upstream DSH source and deploy an update through the local Docker host.",
  "displayName": "DSH Docker 升级",
  "type": "module",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "repository": { "type": "git", "url": "git+https://github.com/compilink/dsh-docker-upgrade-plugin.git" },
  "engines": { "node": ">=22.19.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings"] }
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test" }
}
